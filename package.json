{
  "name": "flint",
  "version": "0.4.5",
  "description": "Flint — Foundry Local Interface (desktop GUI for Microsoft Foundry Local)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "ensure:foundry": "node scripts/ensure-foundry-native.cjs",
    "ensure:node": "node scripts/ensure-bundled-node.cjs",
    "smoke:node": "node scripts/smoke-bundled-node.cjs",
    "tauri:build": "tauri build",
    "verify:bundle": "node scripts/verify-bundle.cjs",
    "run:built": "pwsh scripts/run-built.ps1",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-versions.cjs"
  },
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2",
    "foundry-local-sdk": "^1.2.3",
    "marked": "^18.0.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^25.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
