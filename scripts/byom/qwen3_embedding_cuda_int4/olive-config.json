{
  "input_model": {
    "type": "HfModel",
    "model_path": "source",
    "load_kwargs": {
      "torch_dtype": "float16",
      "local_files_only": true
    }
  },
  "systems": {
    "local_system": {
      "type": "LocalSystem",
      "accelerators": [
        {
          "device": "gpu",
          "execution_providers": [
            "CUDAExecutionProvider"
          ]
        }
      ]
    }
  },
  "passes": {
    "s": {
      "type": "SelectiveMixedPrecision",
      "algorithm": "kld_gradient",
      "bits": 4,
      "high_bits": 8,
      "ratio": 0.65,
      "sym": false,
      "group_size": 128
    },
    "g": {
      "type": "gptq",
      "bits": 4,
      "sym": false,
      "group_size": 128
    },
    "r": {
      "type": "rtn",
      "bits": 8,
      "sym": false,
      "group_size": 128,
      "lm_head": true,
      "embeds": false,
      "overrides": {
        "lm_head": {
          "bits": 8
        }
      }
    },
    "m": {
      "type": "ModelBuilder",
      "precision": "int4",
      "extra_options": {
        "include_hidden_states": 1
      }
    },
    "t": {
      "type": "GraphSurgeries",
      "surgeries": [
        {
          "surgeon": "TieWordEmbeddings"
        }
      ]
    }
  },
  "target": "local_system",
  "log_severity_level": 0,
  "output_dir": "build-output",
  "cache_dir": "build-cache",
  "no_artifacts": true
}
