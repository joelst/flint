{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flint",
  "version": "0.2.0",
  "identifier": "com.flint.flint",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Flint",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* https://localhost:* ws://localhost:*; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../node_modules/foundry-local-sdk",
      "../node_modules/foundry-local-sdk-winml",
      "../sidecar"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "PLACEHOLDER - run: npx tauri signer generate   (copy the public key here for self-signed bootstrap)",
      "endpoints": [
        "https://github.com/YOUR_ORG/flint/releases/download/{{current_version}}/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
