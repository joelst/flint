<?xml version="1.0" encoding="utf-8"?>
<?if $(sys.BUILDARCH)="x86"?>
    <?define Win64 = "no" ?>
<?elseif $(sys.BUILDARCH)="x64"?>
    <?define Win64 = "yes" ?>
<?elseif $(sys.BUILDARCH)="arm64"?>
    <?define Win64 = "yes" ?>
<?else?>
    <?error Unsupported value of sys.BUILDARCH=$(sys.BUILDARCH)?>
<?endif?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Fragment>
    <!-- Foundry 2.0.1 and 1.2.4 publish different ONNX Runtime builds under the
         same filenames. Windows Installer will not replace a higher file
         version. Move the installed tree aside before InstallFiles. If the move
         fails, the install stops and the original tree is still in place. If a
         later step fails, the rollback action puts the tree back. The backup is
         removed during the commit phase. A commit action is sequenced before
         InstallFinalize because Windows Installer only writes deferred,
         rollback, and commit actions into the execution script between
         InstallInitialize and InstallFinalize; it still runs after the install
         has succeeded.

         Each action runs with INSTALLDIR as its working directory and names the
         two folders relative to it. The install location is never substituted
         into the command line, so a value passed on the msiexec command line
         cannot append another command to a call that runs as SYSTEM. -->
    <CustomAction Id="MoveFoundrySdk"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /c if exist &quot;foundry-local-sdk.failed&quot; (rmdir /s /q &quot;foundry-local-sdk.failed&quot; &amp; if exist &quot;foundry-local-sdk.failed&quot; exit /b 1) &amp; set LIVE=&amp; if exist &quot;foundry-local-sdk\prebuilds\win32-x64\onnxruntime.dll&quot; set LIVE=1&amp; if exist &quot;foundry-local-sdk\prebuilds\win32-arm64\onnxruntime.dll&quot; set LIVE=1&amp; if exist &quot;foundry-local-sdk\foundry-local-core\win32-x64\onnxruntime.dll&quot; set LIVE=1&amp; if exist &quot;foundry-local-sdk\foundry-local-core\win32-arm64\onnxruntime.dll&quot; set LIVE=1&amp; if exist &quot;foundry-local-sdk.previous&quot; (if defined LIVE (rmdir /s /q &quot;foundry-local-sdk.previous&quot; &amp; if exist &quot;foundry-local-sdk.previous&quot; ren &quot;foundry-local-sdk.previous&quot; &quot;foundry-local-sdk.previous-kept&quot; &amp; if exist &quot;foundry-local-sdk.previous&quot; exit /b 1) else (if exist &quot;foundry-local-sdk.failed&quot; rmdir /s /q &quot;foundry-local-sdk.failed&quot; &amp; if exist &quot;foundry-local-sdk&quot; ren &quot;foundry-local-sdk&quot; &quot;foundry-local-sdk.failed&quot; &amp; ren &quot;foundry-local-sdk.previous&quot; &quot;foundry-local-sdk&quot; &amp; if exist &quot;foundry-local-sdk.previous&quot; exit /b 1))&amp; if exist &quot;foundry-local-sdk&quot; (ren &quot;foundry-local-sdk&quot; &quot;foundry-local-sdk.previous&quot; &amp; if exist &quot;foundry-local-sdk&quot; exit /b 1)"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no" />
    <CustomAction Id="RestoreFoundrySdk"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /c if exist &quot;foundry-local-sdk.previous&quot; (if exist &quot;foundry-local-sdk.failed&quot; rmdir /s /q &quot;foundry-local-sdk.failed&quot; &amp; if exist &quot;foundry-local-sdk&quot; ren &quot;foundry-local-sdk&quot; &quot;foundry-local-sdk.failed&quot; &amp; ren &quot;foundry-local-sdk.previous&quot; &quot;foundry-local-sdk&quot; &amp; if exist &quot;foundry-local-sdk.previous&quot; exit /b 1)"
                  Execute="rollback"
                  Return="check"
                  Impersonate="no" />
    <CustomAction Id="DiscardFoundryBackup"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /c if exist &quot;foundry-local-sdk.previous&quot; rmdir /s /q &quot;foundry-local-sdk.previous&quot;"
                  Execute="commit"
                  Return="check"
                  Impersonate="no" />
    <InstallExecuteSequence>
      <Custom Action="RestoreFoundrySdk" Before="MoveFoundrySdk">NOT REMOVE</Custom>
      <Custom Action="MoveFoundrySdk" Before="InstallFiles">NOT REMOVE</Custom>
      <Custom Action="DiscardFoundryBackup" Before="InstallFinalize">NOT REMOVE</Custom>
    </InstallExecuteSequence>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="FoundrySdkReplaceMarker" Guid="c4a91e27-8b3d-4e6a-9f15-2d7c0b6e41a8" Win64="$(var.Win64)">
        <RegistryValue Root="HKCU"
                       Key="Software\flint\Flint"
                       Name="FoundrySdkReplace"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <!-- The three custom actions run with INSTALLDIR as their working
             directory, and a process cannot start in a directory that does not
             exist yet. CreateFolders runs before InstallFiles, so a first
             install has the folder by the time MoveFoundrySdk runs. -->
        <CreateFolder />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
