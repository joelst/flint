<?xml version="1.0" encoding="utf-8"?>
<?if $(sys.BUILDARCH)="x86"?>
    <?define Win64 = "no" ?>
<?elseif $(sys.BUILDARCH)="x64"?>
    <?define Win64 = "yes" ?>
<?elseif $(sys.BUILDARCH)="arm64"?>
    <?define Win64 = "yes" ?>
<?else?>
    <?error Unsupported value of sys.BUILDARCH=$(sys.BUILDARCH)?>
<?endif?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Fragment>
    <!-- 0.9.1's Foundry 2.0.1 binaries have a higher file version than 1.2.4.
         Windows Installer will not replace them. Move the installed tree
         aside before InstallFiles. If the move fails, the install stops and
         the original tree is still in place. If a later step fails, the
         rollback action puts the tree back. The backup is removed only after
         the install commits.

         Each action runs with INSTALLDIR as its working directory and names the
         two folders relative to it. The install location is never substituted
         into the command line. -->
    <CustomAction Id="MoveFoundrySdk"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /c set LIVE=&amp; if exist &quot;foundry-local-sdk\prebuilds\win32-x64\onnxruntime.dll&quot; set LIVE=1&amp; if exist &quot;foundry-local-sdk\prebuilds\win32-arm64\onnxruntime.dll&quot; set LIVE=1&amp; if exist &quot;foundry-local-sdk\foundry-local-core\win32-x64\onnxruntime.dll&quot; set LIVE=1&amp; if exist &quot;foundry-local-sdk\foundry-local-core\win32-arm64\onnxruntime.dll&quot; set LIVE=1&amp; if exist &quot;foundry-local-sdk.previous&quot; (if defined LIVE (rmdir /s /q &quot;foundry-local-sdk.previous&quot; &amp; if exist &quot;foundry-local-sdk.previous&quot; ren &quot;foundry-local-sdk.previous&quot; &quot;foundry-local-sdk.previous-kept&quot; &amp; if exist &quot;foundry-local-sdk.previous&quot; exit /b 1) else (if exist &quot;foundry-local-sdk.failed&quot; rmdir /s /q &quot;foundry-local-sdk.failed&quot; &amp; if exist &quot;foundry-local-sdk&quot; ren &quot;foundry-local-sdk&quot; &quot;foundry-local-sdk.failed&quot; &amp; ren &quot;foundry-local-sdk.previous&quot; &quot;foundry-local-sdk&quot; &amp; if exist &quot;foundry-local-sdk.previous&quot; exit /b 1))&amp; if exist &quot;foundry-local-sdk&quot; (ren &quot;foundry-local-sdk&quot; &quot;foundry-local-sdk.previous&quot; &amp; if exist &quot;foundry-local-sdk&quot; exit /b 1)"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no" />
    <CustomAction Id="RestoreFoundrySdk"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /c if exist &quot;foundry-local-sdk.previous&quot; (if exist &quot;foundry-local-sdk.failed&quot; rmdir /s /q &quot;foundry-local-sdk.failed&quot; &amp; if exist &quot;foundry-local-sdk&quot; ren &quot;foundry-local-sdk&quot; &quot;foundry-local-sdk.failed&quot; &amp; ren &quot;foundry-local-sdk.previous&quot; &quot;foundry-local-sdk&quot; &amp; if exist &quot;foundry-local-sdk.previous&quot; exit /b 1)"
                  Execute="rollback"
                  Return="check"
                  Impersonate="no" />
    <CustomAction Id="DiscardFoundryBackup"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /c if exist &quot;foundry-local-sdk.previous&quot; rmdir /s /q &quot;foundry-local-sdk.previous&quot;"
                  Execute="commit"
                  Return="check"
                  Impersonate="no" />
    <InstallExecuteSequence>
      <Custom Action="RestoreFoundrySdk" Before="MoveFoundrySdk">NOT REMOVE</Custom>
      <Custom Action="MoveFoundrySdk" Before="InstallFiles">NOT REMOVE</Custom>
      <Custom Action="DiscardFoundryBackup" After="InstallFinalize">NOT REMOVE</Custom>
    </InstallExecuteSequence>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="FoundrySdkDowngradeMarker" Guid="b7e2c4a1-6d58-4f0e-9c3a-1a8e5d2f70b4" Win64="$(var.Win64)">
        <RegistryValue Root="HKCU"
                       Key="Software\flint\Flint"
                       Name="FoundrySdkDowngrade"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
