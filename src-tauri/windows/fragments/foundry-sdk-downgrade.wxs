<?xml version="1.0" encoding="utf-8"?>
<?if $(sys.BUILDARCH)="x86"?>
    <?define Win64 = "no" ?>
<?elseif $(sys.BUILDARCH)="x64"?>
    <?define Win64 = "yes" ?>
<?elseif $(sys.BUILDARCH)="arm64"?>
    <?define Win64 = "yes" ?>
<?else?>
    <?error Unsupported value of sys.BUILDARCH=$(sys.BUILDARCH)?>
<?endif?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Fragment>
    <!-- 0.9.1's Foundry 2.0.1 binaries have a higher file version than 1.2.4.
         Windows Installer will not replace them. Move the installed tree
         aside before InstallFiles. If the move fails, the install stops and
         the original tree is still in place. If a later step fails, the
         rollback action puts the tree back. The backup is removed during the
         commit phase; cleanup warnings must not fail the committed install.
         A commit action is sequenced before InstallFinalize because Windows
         Installer only writes deferred, rollback, and commit actions into the
         execution script between InstallInitialize and InstallFinalize
         (ICE77); it still runs after the install has succeeded.

         Each action runs with INSTALLDIR as its working directory and names the
         folders relative to it. The install location is never substituted
         into the command line.

         In cmd, everything after `if exist X` on the same line, including
         later `&` commands, belongs to that `if`. Every conditional below is
         therefore wrapped in its own parentheses. scripts/foundry-sdk-downgrade.test.js
         runs these command lines against folder fixtures.

         A working SDK is 2.0.1 (prebuilds\<arch>\onnxruntime.dll) or 1.2.4
         (foundry-local-core\<arch>\Microsoft.AI.Foundry.Local.Core.dll).

         foundry-local-sdk.moved marks foundry-local-sdk.previous as the copy
         this install moved aside. It is written, and checked, before anything
         is renamed, so a failure at any later point, including this process
         dying, leaves rollback a marker to act on. A move that did not happen
         removes it again. The commit action and a finished rollback delete it. Rollback restores only while the marker is present, so a
         leftover .previous is never put over the installed SDK. A .previous
         that still has its marker is from an install that did not commit, so
         the next install keeps it as the backup even when the current tree
         has a runtime. A kept backup stays where it is: the current tree is
         parked at .failed and the backup is marked, so nothing is renamed
         twice in a row. -->
    <CustomAction Id="MoveFoundrySdk"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /c set LIVE=&amp; set RECOVER=&amp; (if exist &quot;foundry-local-sdk.moved&quot; set RECOVER=1) &amp; (if exist &quot;foundry-local-sdk.failed&quot; rmdir /s /q &quot;foundry-local-sdk.failed&quot;) &amp; (if exist &quot;foundry-local-sdk.failed&quot; exit /b 1) &amp; (if exist &quot;foundry-local-sdk\prebuilds\win32-x64\onnxruntime.dll&quot; set LIVE=1) &amp; (if exist &quot;foundry-local-sdk\prebuilds\win32-arm64\onnxruntime.dll&quot; set LIVE=1) &amp; (if exist &quot;foundry-local-sdk\foundry-local-core\win32-x64\Microsoft.AI.Foundry.Local.Core.dll&quot; set LIVE=1) &amp; (if exist &quot;foundry-local-sdk\foundry-local-core\win32-arm64\Microsoft.AI.Foundry.Local.Core.dll&quot; set LIVE=1) &amp; (if not defined LIVE set RECOVER=1) &amp; (if exist &quot;foundry-local-sdk.previous&quot; if not defined RECOVER rmdir /s /q &quot;foundry-local-sdk.previous&quot;) &amp; (if exist &quot;foundry-local-sdk.previous&quot; if not defined RECOVER if exist &quot;foundry-local-sdk.previous-kept&quot; rmdir /s /q &quot;foundry-local-sdk.previous-kept&quot;) &amp; (if exist &quot;foundry-local-sdk.previous&quot; if not defined RECOVER ren &quot;foundry-local-sdk.previous&quot; &quot;foundry-local-sdk.previous-kept&quot;) &amp; (if exist &quot;foundry-local-sdk.previous&quot; if not defined RECOVER exit /b 1) &amp; (if exist &quot;foundry-local-sdk.previous&quot; type nul&gt; &quot;foundry-local-sdk.moved&quot;) &amp; (if exist &quot;foundry-local-sdk&quot; type nul&gt; &quot;foundry-local-sdk.moved&quot;) &amp; (if exist &quot;foundry-local-sdk.previous&quot; if not exist &quot;foundry-local-sdk.moved&quot; exit /b 1) &amp; (if exist &quot;foundry-local-sdk&quot; if not exist &quot;foundry-local-sdk.moved&quot; exit /b 1) &amp; (if exist &quot;foundry-local-sdk.previous&quot; if exist &quot;foundry-local-sdk&quot; ren &quot;foundry-local-sdk&quot; &quot;foundry-local-sdk.failed&quot;) &amp; (if exist &quot;foundry-local-sdk.previous&quot; if exist &quot;foundry-local-sdk&quot; exit /b 1) &amp; (if exist &quot;foundry-local-sdk&quot; ren &quot;foundry-local-sdk&quot; &quot;foundry-local-sdk.previous&quot;) &amp; (if exist &quot;foundry-local-sdk&quot; (del /f /q &quot;foundry-local-sdk.moved&quot; &amp; exit /b 1)) &amp; (if not exist &quot;foundry-local-sdk.previous&quot; if exist &quot;foundry-local-sdk.moved&quot; del /f /q &quot;foundry-local-sdk.moved&quot;) &amp; exit /b 0"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no" />
    <CustomAction Id="RestoreFoundrySdk"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /c (if not exist &quot;foundry-local-sdk.moved&quot; exit /b 0) &amp; (if exist &quot;foundry-local-sdk.previous&quot; if exist &quot;foundry-local-sdk.failed&quot; rmdir /s /q &quot;foundry-local-sdk.failed&quot;) &amp; (if exist &quot;foundry-local-sdk.previous&quot; if exist &quot;foundry-local-sdk&quot; ren &quot;foundry-local-sdk&quot; &quot;foundry-local-sdk.failed&quot;) &amp; (if exist &quot;foundry-local-sdk.previous&quot; if not exist &quot;foundry-local-sdk&quot; ren &quot;foundry-local-sdk.previous&quot; &quot;foundry-local-sdk&quot;) &amp; (if exist &quot;foundry-local-sdk.previous&quot; exit /b 1) &amp; del /f /q &quot;foundry-local-sdk.moved&quot; &amp; exit /b 0"
                  Execute="rollback"
                  Return="check"
                  Impersonate="no" />
    <!-- The commit action deletes the backup, so the install must not commit
         without a runtime. If InstallFiles left no runtime, this fails the
         install and rollback puts the marked backup back. -->
    <CustomAction Id="CheckFoundryRuntime"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /c (if exist &quot;foundry-local-sdk\prebuilds\win32-x64\onnxruntime.dll&quot; exit /b 0) &amp; (if exist &quot;foundry-local-sdk\prebuilds\win32-arm64\onnxruntime.dll&quot; exit /b 0) &amp; (if exist &quot;foundry-local-sdk\foundry-local-core\win32-x64\Microsoft.AI.Foundry.Local.Core.dll&quot; exit /b 0) &amp; (if exist &quot;foundry-local-sdk\foundry-local-core\win32-arm64\Microsoft.AI.Foundry.Local.Core.dll&quot; exit /b 0) &amp; exit /b 1"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no" />
    <CustomAction Id="DiscardFoundryBackup"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /c (if exist &quot;foundry-local-sdk.moved&quot; del /f /q &quot;foundry-local-sdk.moved&quot;) &amp; (if exist &quot;foundry-local-sdk.previous-kept&quot; rmdir /s /q &quot;foundry-local-sdk.previous-kept&quot;) &amp; (if exist &quot;foundry-local-sdk.previous&quot; rmdir /s /q &quot;foundry-local-sdk.previous&quot;) &amp; (if exist &quot;foundry-local-sdk.previous&quot; echo Warning: foundry-local-sdk.previous could not be removed.)"
                  Execute="commit"
                  Return="ignore"
                  Impersonate="no" />
    <!-- NOT Installed limits the move to a first install or an upgrade. A
         repair or feature change of this product does not move the SDK. -->
    <InstallExecuteSequence>
      <Custom Action="RestoreFoundrySdk" Before="MoveFoundrySdk">NOT Installed AND NOT REMOVE</Custom>
      <Custom Action="MoveFoundrySdk" Before="InstallFiles">NOT Installed AND NOT REMOVE</Custom>
      <Custom Action="CheckFoundryRuntime" After="InstallFiles">NOT Installed AND NOT REMOVE</Custom>
      <Custom Action="DiscardFoundryBackup" Before="InstallFinalize">NOT Installed AND NOT REMOVE</Custom>
    </InstallExecuteSequence>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="FoundrySdkDowngradeMarker" Guid="b7e2c4a1-6d58-4f0e-9c3a-1a8e5d2f70b4" Win64="$(var.Win64)">
        <RegistryValue Root="HKCU"
                       Key="Software\flint\Flint"
                       Name="FoundrySdkDowngrade"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <!-- The custom actions run with INSTALLDIR as their working
             directory, and a process cannot start in a directory that does not
             exist yet. CreateFolders runs before InstallFiles, so a first
             install has the folder by the time MoveFoundrySdk runs. -->
        <CreateFolder />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
