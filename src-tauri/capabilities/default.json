{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "dialog:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    // Updater permissions (added for 0.3 release pipeline / self-signed artifacts).
    // Runtime "check for updates" UI is deferred until pre-1.0.
    "updater:allow-check",
    "updater:allow-download-and-install",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "node",
          "cmd": "node",
          "args": [{ "validator": "^[^-].*[/\\\\]foundry-sidecar\\.js$" }]
        }
      ]
    },
    {
      "identifier": "shell:allow-stdin-write",
      "allow": [
        {
          "name": "node",
          "cmd": "node",
          "args": [{ "validator": "^[^-].*[/\\\\]foundry-sidecar\\.js$" }]
        }
      ]
    }
  ]
}
